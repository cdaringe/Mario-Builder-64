# Mario Builder 64 Library Export
# Usage: make -f Makefile.lib
#
# Exports Mario Builder 64 level loading functionality as a library for integration
# into external projects like SM64CoopDX. Provides complete API without requiring
# integrators to define any structures manually.
#
# REQUIREMENTS for host projects:
# - Must provide N64/SM64 compatibility headers: ultra64.h, PR/gbi.h, PR/ultratypes.h
# - Must define N64 types: OSThread, OSMesgQueue, Gfx, Mtx, Vp, Vtx, Vec3f, Vec3s, etc.
# - Must provide standard math constants: M_PI, and macros: MAX, MIN

default: all

# Build configuration
BUILD_DIR := build/lib
CC := gcc
CXX := g++
AR := ar
CFLAGS := -O2 -Wall -Wextra -std=c99
# Defines for host build
DEFINES := -DTARGET_N64=0 -DVERSION_US=1 -DSRAM=1 -DNO_ERRNO_H=1

# Library export configuration
# Host project provides heavy dependencies at link time
INCLUDES ?= -Ilib/stub
INCLUDES := $(INCLUDES) -Isrc -I. -Isrc/libcart/include -Iinclude

# Public API header that gets exported with the library
PUBLIC_HEADERS := include/mb64_api.h

INTERNAL_INCLUDES_DROPPED :=
PARENT_INCLUDES_CANDIDATES :=

# ifdef PARENT_INCLUDES
# 	PARENT_INCLUDES_CANDIDATES := $(subst $(comma),$(space),$(PARENT_INCLUDES))
# 	# Drop all files that perfectly match from parent build from local build
# 	# Maybe pass a basedir instead.
# 	# This is terrible in bash.
# 	INTERNAL_INCLUDES_NORMALIZED := $(filter-out $(MB64_DEFAULT_INCLUDES),$(PARENT_INCLUDES_CANDIDATES_NORMALIZED))
#   INTERNAL_INCLUDES_DROPPED := $(filter-out $(MB64_DEFAULT_INCLUDES),$(INTERNAL_INCLUDES_NORMALIZED))
# 	INCLUDES := $(INCLUDES) -I.. -I../include $(addprefix -I,$(INTERNAL_INCLUDES_NORMALIZED)) $(addprefix -I.,$(PARENT_INCLUDES_CANDIDATES))
# 	DEFINES := $(DEFINES) -DNON_MATCHING=1 -DAVOID_UB=1
# else
# 	INCLUDES := $(INCLUDES) $(addprefix -I,$(MB64_DEFAULT_INCLUDES))
# endif

#==============================================================================#
# Library Source Definitions                                                  #
#==============================================================================#

# Dependencies that host projects (SM64CoopDX) should provide at link time
HOST_PROVIDED_SOURCES := \
	src/engine/math_util.c \
	src/engine/surface_collision.c \
	src/engine/surface_load.c \
	src/engine/graph_node.c \
	src/engine/graph_node_manager.c \
	src/engine/behavior_script.c \
	src/game/materials.c \
	src/game/mario_misc.c \
	src/game/debug.c \
	src/mb64/main.c \
	src/mb64/data.c

# Library export sources - minimal, focused on level loading API
LIBRARY_SOURCES := \
	src/mb64/compatibility.c \
	src/mb64/level_api.c \
	src/mb64/level_disk_api.c \
	src/engine/geo_layout.c \
	src/engine/colors.c

# Core sources for library export
CORE_SOURCES := $(LIBRARY_SOURCES)

# Legacy individual source definitions (for component libraries)
MATH_SOURCES := src/engine/math_util.c
COLLISION_SOURCES := src/engine/surface_collision.c src/engine/surface_load.c
BEHAVIOR_SOURCES := src/engine/behavior_script.c
GEO_SOURCES := src/engine/geo_layout.c src/engine/graph_node.c src/engine/graph_node_manager.c
MATERIAL_SOURCES := src/engine/colors.c src/game/materials.c

# Excluded from main library (editor-only)
MB64_MENU_SOURCES := src/mb64/menu.c src/mb64/menu_engine.c src/mb64/menu_settings.c
MB64_DISPLAY_SOURCES := src/mb64/display_funcs.c src/mb64/painting_frame.c
MB64_MAIN_SOURCES := src/mb64/main.c
AUDIO_SOURCES := src/audio/external.c

# Object file lists
MATH_OBJECTS := $(MATH_SOURCES:%.c=$(BUILD_DIR)/%.o)
COLLISION_OBJECTS := $(COLLISION_SOURCES:%.c=$(BUILD_DIR)/%.o)
BEHAVIOR_OBJECTS := $(BEHAVIOR_SOURCES:%.c=$(BUILD_DIR)/%.o)
GEO_OBJECTS := $(GEO_SOURCES:%.c=$(BUILD_DIR)/%.o)
MATERIAL_OBJECTS := $(MATERIAL_SOURCES:%.c=$(BUILD_DIR)/%.o)
MB64_CORE_OBJECTS := $(MB64_CORE_SOURCES:%.c=$(BUILD_DIR)/%.o)
MB64_MENU_OBJECTS := $(MB64_MENU_SOURCES:%.c=$(BUILD_DIR)/%.o)
MB64_DISPLAY_OBJECTS := $(MB64_DISPLAY_SOURCES:%.c=$(BUILD_DIR)/%.o)
MB64_MAIN_OBJECTS := $(MB64_MAIN_SOURCES:%.c=$(BUILD_DIR)/%.o)
GAME_UTIL_OBJECTS := $(GAME_UTIL_SOURCES:%.c=$(BUILD_DIR)/%.o)
AUDIO_OBJECTS := $(AUDIO_SOURCES:%.c=$(BUILD_DIR)/%.o)

#==============================================================================#
# Library Targets                                                             #
#==============================================================================#

.PHONY: all library mb64-levels libs clean list-libs help show-sources install-headers
.PHONY: math-lib collision-lib behavior-lib geo-lib material-lib
.PHONY: mb64-core-lib mb64-menu-lib mb64-display-lib mb64-main-lib game-util-lib audio-lib

# Default target builds library for level loading integration
all: library

# Build all individual libraries (for development/debugging)
libs: math-lib collision-lib behavior-lib geo-lib material-lib mb64-core-lib game-util-lib

# PRIMARY TARGET: Mario Builder 64 Library Export
library: $(BUILD_DIR)/libmb64-levels.a install-headers
mb64-levels: library  # Legacy alias

# Combined library objects based on build mode
CORE_OBJECTS := $(CORE_SOURCES:%.c=$(BUILD_DIR)/%.o)

$(BUILD_DIR)/libmb64-levels.a: $(CORE_OBJECTS)
	@echo "Building Mario Builder 64 Library Export: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^
	@echo "✓ Library ready for integration: $@"

# Individual library targets
math-lib: $(BUILD_DIR)/libmb64-math.a
collision-lib: $(BUILD_DIR)/libmb64-collision.a
behavior-lib: $(BUILD_DIR)/libmb64-behavior.a
geo-lib: $(BUILD_DIR)/libmb64-geo.a
material-lib: $(BUILD_DIR)/libmb64-material.a
mb64-core-lib: $(BUILD_DIR)/libmb64-core.a
mb64-menu-lib: $(BUILD_DIR)/libmb64-menu.a
mb64-display-lib: $(BUILD_DIR)/libmb64-display.a
mb64-main-lib: $(BUILD_DIR)/libmb64-main.a
game-util-lib: $(BUILD_DIR)/libmb64-gameutil.a
audio-lib: $(BUILD_DIR)/libmb64-audio.a

#==============================================================================#
# Library Build Rules                                                         #
#==============================================================================#

$(BUILD_DIR)/libmb64-math.a: $(MATH_OBJECTS)
	@echo "Building Math Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-collision.a: $(COLLISION_OBJECTS)
	@echo "Building Collision Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-behavior.a: $(BEHAVIOR_OBJECTS)
	@echo "Building Behavior Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-geo.a: $(GEO_OBJECTS)
	@echo "Building Geometry Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-material.a: $(MATERIAL_OBJECTS)
	@echo "Building Material Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-core.a: $(MB64_CORE_OBJECTS)
	@echo "Building MB64 Core Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-menu.a: $(MB64_MENU_OBJECTS)
	@echo "Building MB64 Menu Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-display.a: $(MB64_DISPLAY_OBJECTS)
	@echo "Building MB64 Display Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-main.a: $(MB64_MAIN_OBJECTS)
	@echo "Building MB64 Main Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-gameutil.a: $(GAME_UTIL_OBJECTS)
	@echo "Building Game Utilities Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

$(BUILD_DIR)/libmb64-audio.a: $(AUDIO_OBJECTS)
	@echo "Building Audio Library: $@"
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

# Compilation rule with conditional includes
$(BUILD_DIR)/%.o: %.c
	@echo "Compiling $<"
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDES) $(DEFINES) -c $< -o $@
# Install public headers for integration
install-headers:
	@echo "Installing public API headers..."
	@mkdir -p $(BUILD_DIR)/include
	@cp $(PUBLIC_HEADERS) $(BUILD_DIR)/include/
	@echo "✓ Headers exported to $(BUILD_DIR)/include/"

# Clean all build artifacts
clean:
	rm -rf $(BUILD_DIR)

#==============================================================================#
# Information Targets                                                         #
#==============================================================================#

help:
	@echo "Mario Builder 64 Library Export"
	@echo "==============================="
	@echo ""
	@echo "PURPOSE: Export MB64 level loading functionality as a library"
	@echo "TARGET: External projects like SM64CoopDX"
	@echo ""
	@echo "🎯 MAIN TARGET:"
	@echo "  library        - Mario Builder 64 library export"
	@echo "                   ➜ build/lib/libmb64-levels.a + headers"
	@echo ""
	@echo "📋 COMMANDS:"
	@echo "  make -f Makefile.lib                      # Build library (default)"
	@echo "  make -f Makefile.lib clean                # Clean build artifacts"
	@echo "  make -f Makefile.lib show-sources         # Show what's included vs host-provided"
	@echo "  make -f Makefile.lib libs                 # Build individual component libraries"
	@echo ""
	@echo "🔗 INTEGRATION:"
	@echo "  LIBS += -L./mario-builder-64/build/lib -lmb64-levels"
	@echo "  INCLUDES += -I./mario-builder-64/build/lib/include"
	@echo "  #include \"mb64_api.h\"  // Complete API - no manual struct definitions needed!"
	@echo ""
	@echo "📦 LIBRARY EXPORTS:"
	@echo "  - build/lib/libmb64-levels.a       # Compiled library"
	@echo "  - build/lib/include/mb64_api.h     # Complete public API header"
	@echo ""
	@echo "🆕 STANDARD DISK LOADING SUPPORT:"
	@echo "  - mb64_load_level_from_disk()      # Load from standard computer filesystem"
	@echo "  - mb64_load_level_from_buffer()    # Load from memory buffer"
	@echo "  - mb64_is_valid_level_file()       # Validate .mb64 files"
	@echo "  - Complements existing mb64_load_level_data() (cartridge/SD)"
	@echo ""
	@echo "⚠️  HOST REQUIREMENTS:"
	@echo "  - N64/SM64 compatibility headers (ultra64.h, PR/gbi.h, etc.)"
	@echo "  - N64 types (OSThread, Gfx, Mtx, Vp, Vtx, Vec3f, Vec3s, etc.)"
	@echo "  - Math constants (M_PI) and macros (MAX, MIN)"
	@echo "  - Host must provide heavy dependencies at link time"

list-libs:
	@echo "=== Mario Builder 64 Library Collection ==="
	@echo ""
	@echo "1. libmb64-math.a (Core Math - Minimal Dependencies)"
	@echo "   Sources: $(MATH_SOURCES)"
	@echo ""
	@echo "2. libmb64-collision.a (Surface Collision)"
	@echo "   Sources: $(COLLISION_SOURCES)"
	@echo ""
	@echo "3. libmb64-behavior.a (Behavior System)"
	@echo "   Sources: $(BEHAVIOR_SOURCES)"
	@echo ""
	@echo "4. libmb64-geo.a (Geometry & Layout)"
	@echo "   Sources: $(GEO_SOURCES)"
	@echo ""
	@echo "5. libmb64-material.a (Colors & Materials)"
	@echo "   Sources: $(MATERIAL_SOURCES)"
	@echo ""
	@echo "6. libmb64-core.a (MB64 Core Editor)"
	@echo "   Sources: $(MB64_CORE_SOURCES)"
	@echo ""
	@echo "7. libmb64-menu.a (MB64 Menu System)"
	@echo "   Sources: $(MB64_MENU_SOURCES)"
	@echo ""
	@echo "8. libmb64-display.a (MB64 Display & Rendering)"
	@echo "   Sources: $(MB64_DISPLAY_SOURCES)"
	@echo ""
	@echo "9. libmb64-main.a (MB64 Main Logic)"
	@echo "   Sources: $(MB64_MAIN_SOURCES)"
	@echo ""
	@echo "10. libmb64-gameutil.a (Game Utilities)"
	@echo "    Sources: $(GAME_UTIL_SOURCES)"
	@echo ""
	@echo "11. libmb64-audio.a (Audio System)"
	@echo "    Sources: $(AUDIO_SOURCES)"

show-sources:
	@echo "=== Mario Builder 64 Library Export Sources ==="
	@echo ""
	@echo "📦 INCLUDED in library export:"
	@echo "$(LIBRARY_SOURCES)" | tr ' ' '\n' | sed 's/^/  /'
	@echo ""
	@echo "🔗 HOST PROVIDED (not included, host must provide at link time):"
	@echo "$(HOST_PROVIDED_SOURCES)" | tr ' ' '\n' | sed 's/^/  /'
	@echo ""
	@echo "Total object files in library: $(words $(CORE_OBJECTS))"
